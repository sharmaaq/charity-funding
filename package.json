{
  "name": "charity-funding",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-charity grant funding platform (Your Place and Our Time demo charities)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "test:e2e": "playwright test",
    "seed": "node scripts/seed.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  },
  "dependencies": {
    "@google-cloud/firestore": "9.4.1",
    "@google-cloud/storage": "9.0.0",
    "busboy": "1.6.0",
    "google-auth-library": "11.3.4",
    "playwright": "1.65.1"
  }
}
